# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # server-only, ingestion + writes
SUPABASE_ANON_KEY=                # frontend / read

# Cron koruması: /api/cron/* cagrilarinda Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Geocoding (mekan lat/lng) - Nominatim varsayilan, anahtar gerekmez.
# Opsiyonel: bir ticari geocoder kullanacaksan anahtari buraya.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# --- Kaynak ayarlari (aktif connector'lar) ---
# Ticketmaster Discovery API — Biletix envanterini RESMI yoldan kapsar (countryCode=TR).
# Ucretsiz anahtar: https://developer.ticketmaster.com  (uygulama olustur -> Consumer Key)
TICKETMASTER_API_KEY=

# SALT iCal: takvime-abone-ol butonundaki webcal:// veya https://....ics adresi.
SALT_ICAL_URL=

# Goethe-Institut Istanbul RSS. Bos birakilirsa connector varsayilan resmi URL'yi kullanir.
GOETHE_RSS_URL=

# kultur.istanbul: connector dahili olarak baseUrl kullanir, anahtar gerekmez.

# Biletix affiliate ID (varsa bilet linklerine ?aff=... eklenir)
BILETIX_AFFILIATE_ID=

# --- ENRICHMENT (v1'de OPSIYONEL, default kapali) ---
# Bos birakilirsa enrich tamamen kural-tabanli calisir. Bir saglayici set edilirse
# lib/enrich.js LLM adimini devreye alir. v1 icin bos birakilmasi onerilir.
ENRICH_PROVIDER=                  # "" | gemini | openai
ENRICH_API_KEY=
